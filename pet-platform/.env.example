# 复制到仓库根目录的 .env（已被 .gitignore 忽略，勿提交）。
# docker compose 会自动读取与 docker-compose.yml 同目录的 .env。

# 必填：JWT HS256 密钥，至少 32 字节，否则后端容器 fail-fast 启动失败。
# 生成一个：openssl rand -base64 48
PET_JWT_SECRET=

# ---- 以下为可选覆盖，注释掉的行留空即使用 docker-compose.yml 中的本地默认值 ----
# PET_DB_PORT=3307
# PET_DB_PASSWORD=root
# PET_REDIS_PORT=6379
# PET_REDIS_PASSWORD=root
# PET_MINIO_API_PORT=9000
# PET_MINIO_CONSOLE_PORT=9001
# PET_MINIO_USER=petadmin
# PET_MINIO_PASSWORD=pet123456
# PET_APP_PORT=8080

# ---- 访问控制（对外部署建议）----
# 接口文档（/doc.html、/v3/api-docs）：容器部署默认关闭，需要调试时改 true
# PET_API_DOCS_ENABLED=false
# 开发默认账号（13800000000 / Pet@123456）：初始化完成、正式交付后关闭
# PET_DEV_DEFAULT_ACCOUNT=disabled
# 基础设施端口绑定地址：默认仅本机可访问；跨机访问时改 0.0.0.0，并同步更换强口令
# PET_DB_BIND=127.0.0.1
# PET_REDIS_BIND=127.0.0.1
# PET_MINIO_BIND=127.0.0.1
# PET_MINIO_CONSOLE_BIND=127.0.0.1

# ---- presign 签发地址 ----
# presigned URL 的 host 参与 SigV4 签名、事后不能替换 → 该值必须是**浏览器实际能访问到**的地址。
# 签发客户端已固定 region，容器侧无需解析该 host。
# 实测矩阵：
#   http://minio:9000             容器 ✓ / 浏览器 ✗ 不解析  → 头像与护理照片全是碎图
#   http://localhost:9000         两边 ✓ ← 缺省值，clone 即用（compose 与 .env 同口径）
#   http://host.docker.internal   曾推荐；实测浏览器 502（本机 Chrome 走系统代理解析不了该名字）→ 已弃用
#   http://<LAN IP>:9000          真机/别的设备浏览时用；换网络/DHCP 重分配即失效（签名 host 不可替换的固有代价）
#   ⚠ 跨机访问 MinIO 时，除改本项外还需把 PET_MINIO_BIND 改为 0.0.0.0
# PET_STORAGE_EXTERNAL_ENDPOINT=http://localhost:9000
