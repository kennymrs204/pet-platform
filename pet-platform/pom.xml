<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.petplatform</groupId>
  <artifactId>pet-platform</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>pet-platform</name>
  <description>B2C 宠物服务/托管平台 - 模块化单体</description>

  <properties>
    <java.version>21</java.version>
    <lombok.version>1.18.48</lombok.version>
    <mybatis-plus.version>3.5.17</mybatis-plus.version>
    <knife4j.version>4.5.0</knife4j.version>
    <!-- knife4j 4.5.0 传递的是 springdoc 2.3.0，其调用 ControllerAdviceBean(Object) 已被
         Spring Framework 6.2（Boot 3.5 线）移除 → /v3/api-docs 抛 NoSuchMethodError。 -->
    <springdoc.version>2.8.17</springdoc.version>
    <redisson.version>4.7.0</redisson.version>
    <jjwt.version>0.13.0</jjwt.version>
    <archunit.version>1.5.0</archunit.version>
  </properties>

  <modules>
    <module>pet-platform-common</module>
    <module>pet-platform-user-api</module>
    <module>pet-platform-user-service</module>
    <module>pet-platform-pet-api</module>
    <module>pet-platform-pet-service</module>
    <module>pet-platform-store-api</module>
    <module>pet-platform-store-service</module>
    <module>pet-platform-employee-api</module>
    <module>pet-platform-employee-service</module>
    <module>pet-platform-catalog-api</module>
    <module>pet-platform-catalog-service</module>
    <module>pet-platform-schedule-api</module>
    <module>pet-platform-schedule-service</module>
    <module>pet-platform-appointment-api</module>
    <module>pet-platform-appointment-service</module>
    <module>pet-platform-order-api</module>
    <module>pet-platform-order-service</module>
    <module>pet-platform-payment-api</module>
    <module>pet-platform-payment-service</module>
    <module>pet-platform-fulfillment-api</module>
    <module>pet-platform-fulfillment-service</module>
    <module>pet-platform-medical-api</module>
    <module>pet-platform-medical-service</module>
    <module>pet-platform-boarding-api</module>
    <module>pet-platform-boarding-service</module>
    <module>pet-platform-recruitment-api</module>
    <module>pet-platform-recruitment-service</module>
    <module>pet-platform-notification-api</module>
    <module>pet-platform-notification-service</module>
    <module>pet-platform-message-api</module>
    <module>pet-platform-message-service</module>
    <module>pet-platform-app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-common</artifactId><version>${project.version}</version></dependency>
      <!-- ADR-029：MinIO SDK 仅在 app 消费（父管版本） -->
      <dependency><groupId>io.minio</groupId><artifactId>minio</artifactId><version>8.5.12</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-user-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-user-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-pet-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-pet-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-store-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-store-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-employee-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-employee-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-catalog-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-catalog-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-schedule-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-schedule-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-appointment-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-appointment-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-order-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-order-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-payment-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-payment-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-fulfillment-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-fulfillment-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-medical-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-medical-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-boarding-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-boarding-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-recruitment-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-recruitment-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-notification-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-notification-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-message-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.petplatform</groupId><artifactId>pet-platform-message-service</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId><version>${mybatis-plus.version}</version></dependency>
      <!-- 3.5.9 起 PaginationInnerInterceptor 等依赖 JSqlParser 的插件被拆到此工件 -->
      <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-jsqlparser</artifactId><version>${mybatis-plus.version}</version></dependency>
      <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-annotation</artifactId><version>${mybatis-plus.version}</version></dependency>
      <dependency><groupId>com.github.xiaoymin</groupId><artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId><version>${knife4j.version}</version></dependency>
      <!-- 覆盖 knife4j 传递来的 springdoc 2.3.0（三件套一起钉，避免 starter/api/common 混版） -->
      <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId><version>${springdoc.version}</version></dependency>
      <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-api</artifactId><version>${springdoc.version}</version></dependency>
      <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-common</artifactId><version>${springdoc.version}</version></dependency>
      <dependency><groupId>org.redisson</groupId><artifactId>redisson-spring-boot-starter</artifactId><version>${redisson.version}</version></dependency>
      <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-api</artifactId><version>${jjwt.version}</version></dependency>
      <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-impl</artifactId><version>${jjwt.version}</version></dependency>
      <dependency><groupId>io.jsonwebtoken</groupId><artifactId>jjwt-jackson</artifactId><version>${jjwt.version}</version></dependency>
      <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><version>${archunit.version}</version></dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        JDK 23 及以上默认不再自动运行 classpath 上的注解处理器，需显式声明 lombok 处理路径并开启 proc:full。
        本机以 openjdk-24 编译、按 release 21 产出 Java 21 字节码（无 JDK 21 环境）。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-proc:full</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
